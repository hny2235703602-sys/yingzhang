[Unit]
Description=Yingzhang Studio web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yingzhang
Group=yingzhang
WorkingDirectory=/opt/yingzhang
EnvironmentFile=/etc/yingzhang/runtime.env
Environment=PYTHONPATH=/opt/yingzhang/src
ExecStartPre=/opt/yingzhang/.venv/bin/alembic upgrade head
ExecStart=/opt/yingzhang/.venv/bin/python -m streamlit run app.py --server.address 127.0.0.1 --server.port 8501
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yingzhang

[Install]
WantedBy=multi-user.target
